<actions>
  <action>
    <icon>media-playback-start</icon>
    <name>Run AppImage</name>
    <unique-id>taskarian-appimage-run-v1</unique-id>
    <command>@PREFIX@/bin/taskarian-app launch %f</command>
    <description>Run this AppImage using the validated Taskarian launcher</description>
    <range>1-1</range>
    <patterns>*.AppImage;*.appimage</patterns>
    <other-files />
  </action>
  <action>
    <icon>package-x-generic</icon>
    <name>Extract and Run AppImage (Persistent)</name>
    <unique-id>taskarian-appimage-extract-run-v1</unique-id>
    <command>@PREFIX@/bin/taskarian-app extract-and-run %f</command>
    <description>Persistently extract beside this AppImage and run it</description>
    <range>1-1</range>
    <patterns>*.AppImage;*.appimage</patterns>
    <other-files />
  </action>
  <action>
    <icon>dialog-warning</icon>
    <name>Extract and Run --no-sandbox</name>
    <unique-id>taskarian-appimage-extract-run-no-sandbox-v1</unique-id>
    <command>@PREFIX@/bin/taskarian-app extract-and-run-no-sandbox %f</command>
    <description>Persistently extract and remember the --no-sandbox launch option</description>
    <range>1-1</range>
    <patterns>*.AppImage;*.appimage</patterns>
    <other-files />
  </action>
  <action>
    <icon>application-x-executable</icon>
    <name>Add AppImage to Applications</name>
    <unique-id>taskarian-appimage-add-applications-v1</unique-id>
    <command>@PREFIX@/bin/taskarian-app register %f</command>
    <description>Register this AppImage in the Applications menu</description>
    <range>1-1</range>
    <patterns>*.AppImage;*.appimage</patterns>
    <other-files />
  </action>
  <action>
    <icon>user-desktop</icon>
    <name>Add AppImage to Desktop</name>
    <unique-id>taskarian-appimage-add-desktop-v1</unique-id>
    <command>@PREFIX@/bin/taskarian-app register --desktop %f</command>
    <description>Create a desktop shortcut linked to this AppImage</description>
    <range>1-1</range>
    <patterns>*.AppImage;*.appimage</patterns>
    <other-files />
  </action>
  <action>
    <icon>application-x-executable</icon>
    <name>Run Desktop Launcher</name>
    <unique-id>taskarian-desktop-run-v1</unique-id>
    <command>@PREFIX@/bin/taskarian-app desktop-launch %f</command>
    <description>Run Desktop Launcher</description>
    <range>1-1</range>
    <patterns>*.desktop</patterns>
    <other-files />
  </action>
  <action>
    <icon>application-x-executable</icon>
    <name>Add Launcher to Applications</name>
    <unique-id>taskarian-desktop-apps-v1</unique-id>
    <command>@PREFIX@/bin/taskarian-app desktop-register %f</command>
    <description>Add Launcher to Applications</description>
    <range>1-1</range>
    <patterns>*.desktop</patterns>
    <other-files />
  </action>
  <action>
    <icon>application-x-executable</icon>
    <name>Add Launcher to Desktop</name>
    <unique-id>taskarian-desktop-desktop-v1</unique-id>
    <command>@PREFIX@/bin/taskarian-app desktop-register --desktop %f</command>
    <description>Add Launcher to Desktop</description>
    <range>1-1</range>
    <patterns>*.desktop</patterns>
    <other-files />
  </action>
  <action>
    <icon>application-x-executable</icon>
    <name>Install Debian Package…</name>
    <unique-id>taskarian-deb-install-v1</unique-id>
    <command>@PREFIX@/bin/taskarian-app install-deb %f</command>
    <description>Install Debian Package…</description>
    <range>1-1</range>
    <patterns>*.deb</patterns>
    <other-files />
  </action>
</actions>
