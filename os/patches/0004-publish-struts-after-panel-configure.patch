+/* BashKitten OS: X11 struts must follow the WM's applied panel geometry.
+ * Publishing before its move can leave a resized desktop's workarea stale.
+ * No X round trip, timer, or alternate window-sizing policy is introduced. */
+static gboolean
+panel_window_configure_event (GtkWidget *widget,
+                              GdkEventConfigure *event)
+{
+  PanelWindow *window = PANEL_WINDOW (widget);
+  GtkWidgetClass *parent = GTK_WIDGET_CLASS (panel_window_parent_class);
+  gboolean handled = parent->configure_event != NULL
+                       ? parent->configure_event (widget, event) : FALSE;
+
+  if (WINDOWING_IS_X11 ())
+    {
+      window->struts_configured = (GdkRectangle) { event->x, event->y,
+                                                  event->width, event->height };
+      window->struts_configured_valid = TRUE;
+      if (gtk_widget_get_mapped (widget)
+          && window->struts_edge != STRUTS_EDGE_NONE
+          && window->autohide_behavior == AUTOHIDE_BEHAVIOR_NEVER)
+        panel_window_screen_struts_set (window);
+    }
+  return handled;
+}
+
+
+static void
+panel_window_unrealize (GtkWidget *widget)
+{
+  PanelWindow *window = PANEL_WINDOW (widget);
+  window->struts_configured_valid = FALSE;
+  memset (window->struts, 0, sizeof (window->struts));
+  GTK_WIDGET_CLASS (panel_window_parent_class)->unrealize (widget);
+}
+
