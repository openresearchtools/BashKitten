<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Systematic Reviewer author-date (minimal)</title>
    <id>https://openresearchtools.github.io/systematic-reviewer/styles/author-date</id>
    <link href="https://openresearchtools.github.io/systematic-reviewer/styles/author-date" rel="self"/>
    <author><name>Systematic Reviewer contributors</name></author>
    <category citation-format="author-date"/>
    <updated>2026-10-22T00:00:00+00:00</updated>
    <rights license="https://www.gnu.org/licenses/agpl-3.0.html">AGPL-3.0-or-later</rights>
  </info>
  <macro name="author">
    <names variable="author">
      <name form="short" and="text" delimiter=", " initialize-with=". "/>
      <substitute><names variable="editor"/><text variable="title"/></substitute>
    </names>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued"><date variable="issued"><date-part name="year"/></date></if>
      <else><text term="no date" form="short"/></else>
    </choose>
  </macro>
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author"/>
        <text macro="year"/>
        <group delimiter=" "><label variable="locator" form="short"/><text variable="locator"/></group>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="true">
    <sort><key macro="author"/><key macro="year"/><key variable="title"/></sort>
    <layout suffix=".">
      <group delimiter=". ">
        <names variable="author"><name name-as-sort-order="all" sort-separator=", " initialize-with=". " and="text"/><substitute><text variable="title"/></substitute></names>
        <text macro="year" prefix="(" suffix=")"/>
        <text variable="title"/>
        <text variable="container-title" font-style="italic"/>
        <text variable="publisher"/>
        <text variable="DOI" prefix="https://doi.org/"/>
      </group>
    </layout>
  </bibliography>
</style>
