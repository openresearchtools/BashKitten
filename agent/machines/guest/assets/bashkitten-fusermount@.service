[Unit]
Description=BashKitten validated AppImage mount handoff

[Service]
Type=exec
ExecStart=/usr/lib/bashkitten/machines/bin/bashkitten-fusermount-exec --serve
User=root
Group=root
UMask=0077
StandardInput=socket
StandardOutput=socket
StandardError=null
KillMode=mixed
TimeoutStartSec=infinity
TimeoutStopSec=30s
