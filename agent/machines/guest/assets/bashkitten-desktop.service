[Unit]
Description=BashKitten container local Agent
After=network.target systemd-user-sessions.service
Requires=bashkitten-sudo.socket
Wants=bashkitten-display.service

[Service]
Type=notify
NotifyAccess=all
User=user
Group=user
Environment=HOME=/home/user
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=BASHKITTEN_EXECUTION_ROLE=container
ExecStart=/usr/bin/dbus-run-session -- /usr/lib/bashkitten/machines/bin/bashkitten-session
KillMode=mixed
TimeoutStopSec=30
TimeoutStartSec=60
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
