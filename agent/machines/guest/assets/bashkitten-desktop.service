[Unit]
Description=BashKitten container XFCE desktop and local Agent
After=network.target systemd-user-sessions.service
Requires=bashkitten-sudo.socket

[Service]
Type=simple
User=user
Group=user
Environment=HOME=/home/user
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=BASHKITTEN_EXECUTION_ROLE=container
ExecStart=/usr/bin/dbus-run-session -- /usr/lib/bashkitten/machines/bin/bashkitten-session
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
