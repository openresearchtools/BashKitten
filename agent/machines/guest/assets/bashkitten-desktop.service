[Unit]
Description=BashKitten container local Agent
After=network.target systemd-user-sessions.service
Requires=bashkitten-sudo.socket
Wants=bashkitten-display.service

[Service]
Type=notify
NotifyAccess=all
Environment=HOME=/home/user USER=user LOGNAME=user SHELL=/bin/bash
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=BASHKITTEN_EXECUTION_ROLE=container
# systemd User= calls initgroups, dropping crun's keep-groups device access.
# Drop all user/group IDs before the session while retaining inherited groups.
ExecStart=/usr/bin/setpriv --reuid=user --regid=user --keep-groups --inh-caps=-all --ambient-caps=-all -- /usr/bin/dbus-run-session -- /usr/lib/bashkitten/machines/bin/bashkitten-session
KillMode=mixed
TimeoutStopSec=30
TimeoutStartSec=60
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
