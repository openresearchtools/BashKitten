[Unit]
Description=Taskarian container Display
After=taskarian-desktop.service
Requires=taskarian-desktop.service
PartOf=taskarian-desktop.service

[Service]
Type=simple
Environment=HOME=/home/user USER=user LOGNAME=user SHELL=/bin/bash
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=TASKARIAN_EXECUTION_ROLE=container
# systemd User= calls initgroups, dropping crun's keep-groups device access.
# Drop all user/group IDs before the session while retaining inherited groups.
ExecStart=/usr/bin/setpriv --reuid=user --regid=user --keep-groups --inh-caps=-all --ambient-caps=-all -- /usr/bin/dbus-run-session -- /usr/lib/taskarian/machines/bin/taskarian-display-session
KillMode=mixed
TimeoutStopSec=30
