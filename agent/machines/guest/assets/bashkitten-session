"""Persistent guest Agent/proxy; Display has its own independently stoppable unit."""
import asyncio
import json
import os
import signal
import uuid
from pathlib import Path

BIN = Path('/usr/lib/bashkitten/machines/bin')
RUN = Path('/run/user/1000')
EXCHANGE = Path('/run/bashkitten-host')
DATA = Path.home() / '.local/share/bashkitten-pi'
CONTEXT = RUN / 'bashkitten-desktop.json'
STATUS = RUN / 'bashkitten-guest-status.json'


def write_json(path, value):
    temporary = path.with_name(path.name + '.tmp')
    temporary.write_text(json.dumps(value) + '\n')
    temporary.chmod(0o600)
    temporary.replace(path)


async def run():
    os.umask(0o077)
    DATA.mkdir(parents=True, exist_ok=True)
    agent_run = EXCHANGE / 'agent'
    agent_run.mkdir(exist_ok=True, mode=0o700)
    link = DATA / 'run'
    if link.is_symlink():
        if link.readlink() != agent_run:
            raise RuntimeError('Guest runtime directory points to an unexpected endpoint')
    elif link.exists():
        raise RuntimeError('Guest runtime directory must use the allocated private endpoint')
    else:
        link.symlink_to(agent_run, target_is_directory=True)
    display = json.loads(Path('/run/bashkitten-settings/display.json').read_text())
    env = {**os.environ, 'BASHKITTEN_EXECUTION_ROLE': 'container',
           'BASHKITTEN_MACHINE_ID': str(uuid.UUID(display['machineId'])),
           'BASHKITTEN_DATA_DIR': str(DATA), 'BASHKITTEN_DESKTOP_CONTEXT': str(CONTEXT),
           'BASHKITTEN_GUEST_STATUS_FILE': str(STATUS)}
    notify_env = env.copy()
    # Only this owner reports the unit's state. Caddy's STOPPING notification
    # during Share Local setup must not stop the entire guest Agent service.
    env.pop('NOTIFY_SOCKET', None)
    stopped = asyncio.Event()
    for sig in [signal.SIGTERM, signal.SIGINT]:
        asyncio.get_running_loop().add_signal_handler(sig, stopped.set)
    proxy = await asyncio.create_subprocess_exec('/usr/lib/bashkitten/node/bin/node', BIN / 'bashkitten-agent-proxy.mjs', env=env)
    try:
        # New guests start Agent by default. On later starts the controller
        # restores its own saved power choice, including an explicit Agent Off,
        # while still starting independently configured background services.
        action = 'autostart-startup' if (DATA / 'control.json').exists() else 'start'
        start = await asyncio.create_subprocess_exec('/usr/bin/bashkittenctl', action, env=env, stdout=asyncio.subprocess.DEVNULL)
        if await start.wait():
            raise RuntimeError('Guest services did not start')
        write_json(STATUS, {'running': True, 'error': None})
        ready = await asyncio.create_subprocess_exec('/usr/bin/systemd-notify', '--ready', env=notify_env)
        if await ready.wait():
            raise RuntimeError('Guest Agent readiness could not be published')
        stop_task = asyncio.create_task(stopped.wait())
        proxy_task = asyncio.create_task(proxy.wait())
        done, _ = await asyncio.wait([stop_task, proxy_task], return_when=asyncio.FIRST_COMPLETED)
        if proxy_task in done and stop_task not in done:
            raise RuntimeError('Guest Agent proxy stopped')
    finally:
        if proxy.returncode is None:
            proxy.terminate()
            try:
                await asyncio.wait_for(proxy.wait(), 5)
            except asyncio.TimeoutError:
                proxy.kill()
                await proxy.wait()
        write_json(STATUS, {'running': False, 'error': None})


if __name__ == '__main__':
    asyncio.run(run())
