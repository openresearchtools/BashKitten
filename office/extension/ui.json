{
  "commands": [
    {
      "id": "citation",
      "title": "Add/Edit Citation",
      "background": true,
      "iconCommand": ".uno:ZoteroAddEditCitation"
    },
    {
      "id": "edit",
      "title": "Edit Citation",
      "background": true,
      "iconCommand": ".uno:Edit"
    },
    {
      "id": "remove",
      "title": "Remove Citation",
      "background": true,
      "iconCommand": ".uno:ZoteroUnlink"
    },
    {
      "id": "bibliography",
      "title": "Add Bibliography",
      "background": true,
      "iconCommand": ".uno:ZoteroAddEditBibliography"
    },
    {
      "id": "refresh",
      "title": "Refresh Citations",
      "background": true,
      "iconCommand": ".uno:ZoteroRefresh"
    },
    {
      "id": "settings",
      "title": "Settings",
      "background": true,
      "iconCommand": ".uno:ZoteroSetDocPrefs"
    },
    {
      "id": "codes",
      "title": "Convert citation codes",
      "background": true,
      "iconCommand": ".uno:InsertField"
    },
    {
      "id": "text-copy",
      "title": "Save copy with text citations",
      "background": true,
      "iconCommand": ".uno:SaveAs"
    },
    {
      "id": "import-snapshots",
      "title": "Import copied references",
      "background": true,
      "iconCommand": ".uno:PasteSpecial"
    }
  ],
  "extensionsMenu": [
    {
      "command": "citation"
    },
    {
      "command": "remove"
    },
    {
      "command": "bibliography"
    },
    {
      "command": "codes"
    },
    {
      "command": "text-copy"
    },
    {
      "command": "import-snapshots"
    },
    {
      "command": "refresh"
    },
    {
      "command": "settings"
    }
  ],
  "menus": {
    "insert": [
      "citation",
      "bibliography"
    ],
    "tools": [
      "refresh",
      "settings",
      "codes"
    ],
    "file": [
      "text-copy"
    ]
  },
  "notebookbar": [
    {
      "tab": "Citations",
      "insertAfter": "Insert",
      "groups": [
        {
          "id": "citations",
          "label": "Citations",
          "items": [
            {
              "type": "button",
              "command": "citation",
              "size": "large"
            },
            {
              "type": "button",
              "command": "remove",
              "size": "large"
            },
            {
              "type": "button",
              "command": "bibliography",
              "size": "large"
            },
            {
              "type": "button",
              "command": "codes",
              "size": "large"
            },
            {
              "type": "button",
              "command": "text-copy",
              "size": "large"
            },
            {
              "type": "button",
              "command": "import-snapshots",
              "size": "large"
            },
            {
              "type": "button",
              "command": "refresh",
              "size": "large"
            },
            {
              "type": "button",
              "command": "settings",
              "size": "large"
            }
          ],
          "nofold": true,
          "mobile": true
        }
      ]
    }
  ],
  "contextMenu": [
    {
      "command": "edit"
    },
    {
      "command": "remove"
    }
  ],
  "keybindings": [
    {
      "command": "citation",
      "key": "c",
      "modifier": [
        "ctrl",
        "alt"
      ]
    }
  ]
