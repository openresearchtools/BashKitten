-ContextHandlerRef ExtLstGlobalContext::onCreateContext( sal_Int32 nElement, const AttributeList& )
+namespace {
+class UserAttributeRangesContext final : public WorksheetContextBase
+{
+public:
+    explicit UserAttributeRangesContext(WorksheetContextBase& rParent)
+        : WorksheetContextBase(rParent) {}
+    ContextHandlerRef onCreateContext(sal_Int32 nElement, const AttributeList& rAttributes) override
+    {
+        if (nElement != LOEXT_TOKEN(range))
+            return nullptr;
+        ScRange aRange;
+        if (!getAddressConverter().convertToCellRange(aRange,
+                rAttributes.getStringDefaulted(XML_ref), getSheetIndex(), true, true))
+            throw css::xml::sax::SAXException(u"Invalid user attribute cell range"_ustr, {}, {});
+        return new UserAttributesContext(*this, [this, aRange](const auto& xAttributes) {
+            getSheetData().setUserAttributes(aRange, cpo::uno::Any(xAttributes));
+        });
+    }
+};
+}
+
+ContextHandlerRef ExtLstGlobalContext::onCreateContext( sal_Int32 nElement, const AttributeList& rAttributes )
 {
     if (nElement == XLS_TOKEN( ext ))
+    {
+        if (rAttributes.getXString(XML_uri, OUString()) == UserAttributesExtensionURI)
+            return new UserAttributeRangesContext(*this);
         return new ExtGlobalContext( *this );
+    }
 
     return this;
 }
