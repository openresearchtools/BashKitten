+// Generic persistence for the existing native UserDefinedAttributes property.
+// No application-specific interpretation belongs in this extension.
+inline constexpr OUString UserAttributesExtensionURI
+    = u"http://schemas.libreoffice.org/user-defined-attributes"_ustr;
+
+inline void writeUserAttributes(const sax_fastparser::FSHelperPtr& xStream,
+    const cpo::uno::Reference<css::container::XNameAccess>& xAttributes)
+{
+    for (const auto& rName : xAttributes->getElementNames())
+    {
+        css::xml::AttributeData aData;
+        if (!(xAttributes->getByName(rName) >>= aData))
+            throw css::xml::sax::SAXException(u"Invalid user-defined attribute"_ustr, {}, {});
+        xStream->singleElementNS(XML_loext, XML_attribute,
+            FSNS(XML_xmlns, XML_loext), u"http://schemas.libreoffice.org/"_ustr,
+            XML_name, rName, XML_uri, aData.Namespace, XML_value, aData.Value);
+    }
+}
+
+// Reads one extension or range containing loext:attribute children. Native UNO
+// insertion retains namespace/prefix validation and rejects duplicate names.
+class UserAttributesContext final : public core::ContextHandler2
+{
+public:
+    using Completion = std::function<void(const cpo::uno::Reference<css::container::XNameContainer>&)>;
+    UserAttributesContext(const core::ContextHandler2Helper& rParent, Completion aComplete)
+        : ContextHandler2(rParent), mxAttributes(new SvUnoAttributeContainer),
+          maComplete(std::move(aComplete)) {}
+
+    core::ContextHandlerRef onCreateContext(sal_Int32 nElement, const AttributeList& rAttributes) override
+    {
+        if (nElement != LOEXT_TOKEN(attribute))
+            return nullptr;
+        const OUString aName = rAttributes.getXString(XML_name, OUString());
+        const sal_Int32 nColon = aName.indexOf(':');
+        const OUString aPrefix = nColon < 0 ? OUString() : aName.copy(0, nColon);
+        const OUString aLocal = nColon < 0 ? aName : aName.copy(nColon + 1);
+        const OUString aNamespace = rAttributes.getXString(XML_uri, OUString());
+        if (!sfx2::isValidNCName(aLocal)
+            || (nColon >= 0 && (!sfx2::isValidNCName(aPrefix) || aNamespace.isEmpty()))
+            || (nColon < 0 && !aNamespace.isEmpty())
+            || mxAttributes->getElementNames().getLength() >= SAL_MAX_UINT16)
+            throw css::xml::sax::SAXException(u"Invalid user-defined attribute name"_ustr, {}, {});
+        css::xml::AttributeData aData;
+        aData.Namespace = aNamespace;
+        aData.Type = u"CDATA"_ustr;
+        aData.Value = rAttributes.getXString(XML_value, OUString());
+        mxAttributes->insertByName(aName, cpo::uno::Any(aData));
+        return nullptr;
+    }
+
+    void onEndElement() override
+    {
+        if (mxAttributes->hasElements())
+            maComplete(mxAttributes);
+    }
+
+private:
+    cpo::uno::Reference<css::container::XNameContainer> mxAttributes;
+    Completion maComplete;
+};
+}
