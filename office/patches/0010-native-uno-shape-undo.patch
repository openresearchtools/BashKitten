+// UNO user-defined attributes are persistent native object data. Reuse the
+// model's attribute undo action; import/export and undo replay stay unchanged.
+void SetItemsWithUserAttributeUndo(SdrObject& object, const SfxItemSet& items)
+{
+    auto& model = object.getSdrModelFromSdrObject();
+    std::unique_ptr<SdrUndoAction> undo;
+    if (model.IsUndoEnabled() && !model.isInImportExport()
+        && items.GetItemState(SDRATTR_XMLATTRIBUTES, false) == SfxItemState::SET
+        && object.GetMergedItem(SDRATTR_XMLATTRIBUTES) != items.Get(SDRATTR_XMLATTRIBUTES))
+        undo = model.GetSdrUndoFactory().CreateUndoAttrObject(object);
+    object.SetMergedItemSetAndBroadcast(items);
+    if (undo)
+        model.AddUndo(std::move(undo));
+}
+}
