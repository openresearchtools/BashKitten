+// User-defined document properties are native persistent metadata. Their changes
+// must join the same native undo context as extension edits, and remain undoable
+// after the originating client disconnects. No client callback is retained.
+struct StoredDocumentProperty
+{
+    beans::Property descriptor;
+    uno::Any value;
+};
+
+std::vector<StoredDocumentProperty> ReadDocumentProperties(
+    const uno::Reference<beans::XPropertySet>& xSet, const std::vector<OUString>& rNames)
+{
+    std::vector<StoredDocumentProperty> result;
+    const auto info = xSet->getPropertySetInfo();
+    for (const auto& name : rNames)
+        if (info->hasPropertyByName(name))
+            result.push_back({ info->getPropertyByName(name), xSet->getPropertyValue(name) });
+    return result;
+}
+
+class DocumentPropertiesUndo final : public cppu::WeakImplHelper<document::XUndoAction>
+{
+    uno::Reference<beans::XPropertyContainer> mxProperties;
+    std::vector<OUString> maNames;
+    std::vector<StoredDocumentProperty> maBefore;
+    std::vector<StoredDocumentProperty> maAfter;
+
+    void apply(const std::vector<StoredDocumentProperty>& rValues)
+    {
+        const uno::Reference<beans::XPropertySet> xSet(mxProperties, UNO_QUERY_THROW);
+        for (const auto& name : maNames)
+            if (xSet->getPropertySetInfo()->hasPropertyByName(name))
+                mxProperties->removeProperty(name);
+        for (const auto& property : rValues)
+            mxProperties->addProperty(property.descriptor.Name, property.descriptor.Attributes,
+                                      property.value);
+    }
+public:
+    DocumentPropertiesUndo(uno::Reference<beans::XPropertyContainer> properties,
+                           std::vector<OUString> names,
+                           std::vector<StoredDocumentProperty> before,
+                           std::vector<StoredDocumentProperty> after)
+        : mxProperties(std::move(properties)), maNames(std::move(names)),
+          maBefore(std::move(before)), maAfter(std::move(after)) {}
+    void undo() override { apply(maBefore); }
+    void redo() override { apply(maAfter); }
+    OUString getTitle() override { return u"Document properties"_ustr; }
+};
