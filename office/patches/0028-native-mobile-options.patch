+
+/* Native Options keeps its controls outside the scrolling settings iframe. */
+@media (max-width: 850px), (max-height: 600px) {
+	.iframe-settings-content {
+		width: min(800px, calc(100vw - 16px));
+		height: min(512px, calc(100dvh - 80px));
+	}
+
+	.iframe-settings-modal {
+		flex: 1 1 0;
+		min-width: 0;
+		min-height: 0;
+		width: 100%;
+	}
+
+	.iframe-settings-content > .ui-button-box {
+		flex: 0 0 auto;
+	}
+}
+
+@media (max-width: 600px) {
+	#settingIframe {
+		padding-inline: 0.5rem;
+		gap: 0.5rem;
+	}
+
+	#allConfigSection {
+		flex: 1;
+		min-width: 0;
+		padding-inline: 0.5rem;
+	}
+
+	.settings-nav-item {
+		overflow-wrap: anywhere;
+	}
+}
