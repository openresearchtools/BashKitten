+// Field results already have native undo actions. Keep the native field command
+// in the same group, including insertion redo (which first recreates an empty mark).
+class FieldCommandUndo final : public SwUndo
+{
+    SwMarkName maName;
+    bool mbHadBefore;
+    cpo::uno::Any maBefore;
+    cpo::uno::Any maAfter;
+
+    void apply(sw::UndoRedoContext& rContext, bool exists, const cpo::uno::Any& value)
+    {
+        auto* access = rContext.GetDoc().getIDocumentMarkAccess();
+        const auto found = access->findMark(maName);
+        if (found == access->getAllMarksEnd())
+            return;
+        auto* field = dynamic_cast<sw::mark::Fieldmark*>(*found);
+        if (!field)
+            return;
+        if (exists)
+            (*field->GetParameters())[ODF_CODE_PARAM] = value;
+        else
+            field->GetParameters()->erase(ODF_CODE_PARAM);
+    }
+public:
+    FieldCommandUndo(SwDoc& doc, sw::mark::Fieldmark& field, cpo::uno::Any after)
+        : SwUndo(SwUndoId::UPDATE_FORM_FIELD, doc), maName(field.GetName()),
+          mbHadBefore(field.GetParameters()->count(ODF_CODE_PARAM) != 0),
+          maAfter(std::move(after))
+    {
+        if (mbHadBefore)
+            maBefore = field.GetParameters()->at(ODF_CODE_PARAM);
+    }
+    void UndoImpl(sw::UndoRedoContext& context) override { apply(context, mbHadBefore, maBefore); }
+    void RedoImpl(sw::UndoRedoContext& context) override { apply(context, true, maAfter); }
+};
+
+static void SetFieldCommandWithUndo(SwDoc& doc, sw::mark::Fieldmark& field,
+                                    const cpo::uno::Any& value)
+{
+    if (doc.GetIDocumentUndoRedo().DoesUndo())
+        doc.GetIDocumentUndoRedo().AppendUndo(std::make_unique<FieldCommandUndo>(doc, field, value));
+    (*field.GetParameters())[ODF_CODE_PARAM] = value;
+}
 
