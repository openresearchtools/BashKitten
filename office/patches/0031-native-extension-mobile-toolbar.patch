+	// Reuse the notebookbar's item adapter and JSDialog's native popup widgets;
+	// phones have no notebookbar of their own.
+	private getExtensionToolItems(): any[] {
+		if (!window.enableExperimentalFeatures) return [];
+		const items: any[] = [];
+		const extensions = this.map._extensions || {};
+		const counter = { _nextContributedId: 0 };
+		const buildItem = window.L.Control.Notebookbar.prototype._buildContributedItem;
+		Object.keys(extensions).sort().forEach((extId, extIndex) => {
+			const { manifest, baseUrl } = extensions[extId].options;
+			const contributes = manifest.contributes;
+			if (!contributes) return;
+			(contributes.notebookbar || []).forEach((tab: ExtensionNotebookbarTab, tabIndex: number) => {
+				tab.groups.forEach((group, groupIndex) => {
+					if (!group.mobile) return;
+					const children = group.items.map((item) => buildItem.call(
+						counter, extId, contributes.commands || [], baseUrl,
+						'notebookbar group "' + group.id + '"', item,
+					)).filter(Boolean).map((item: any) => ({ ...item, cssClass: 'notebookbar' }));
+					if (!children.length) return;
+					const id = 'extmobile_' + extIndex + '_' + tabIndex + '_' + groupIndex;
+					items.push({
+						id, type: 'menubutton', text: group.label, noLabel: true,
+						icon: children.find((item: any) => item.icon)?.icon,
+						menu: [{ type: 'json', content: {
+							id: id + '_scroll', type: 'scrollwindow', cssClass: 'ui-extension-mobile-toolbar',
+							vertical: { policy: 'never' }, horizontal: { policy: 'always' },
+							children: [{ id: id + '_tools', type: 'toolbox', cssClass: 'notebookbar', children }],
+						} }, { type: 'separator' }],
+					});
+				});
+			});
+		});
+		return items;
+	}
+
+	// Discovery finishes after the normal controls are live. Insert only the
+	// contributed controls so Undo/Redo and the current permission state survive.
+	refreshExtensions() {
+		const before = this.getItemElement('undo');
+		for (const item of this.getExtensionToolItems()) {
+			if (this.getItemElement(item.id)) continue;
+			this.builder.build(this.parentContainer, [item]);
+			const control = this.getItemElement(item.id);
+			if (control && before) this.parentContainer.insertBefore(control, before);
+			this.showItem(item.id, this.map.isEditMode());
+		}
+	}
+
 	create() {
 		const items = this.getToolItems();
 		this.builder.build(this.parentContainer, items);
+		this.refreshExtensions();
 	}
 
