diff --git a/engine/solenv/gbuild/ExternalProject.mk b/engine/solenv/gbuild/ExternalProject.mk
--- a/engine/solenv/gbuild/ExternalProject.mk
+++ b/engine/solenv/gbuild/ExternalProject.mk
@@ -209,6 +209,12 @@
 
 endef
 
+# Libtool omits the Android compiler's implicit builtins archive from shared
+# library links. Keep an explicit -l input, as in the native libetonyek recipe.
+gb_ExternalProject_BIONIC_BUILTINS := $(if $(COM_IS_BIONIC),$(shell $(CC) -print-libgcc-file-name))
+gb_ExternalProject_BIONIC_LIBS := $(if $(gb_ExternalProject_BIONIC_BUILTINS),\
+    -L$(dir $(gb_ExternalProject_BIONIC_BUILTINS)) -l:$(notdir $(gb_ExternalProject_BIONIC_BUILTINS)))
+
 # Returns flags to include in CFLAGS/CXXFLAGS to enable optimizations and/or debugging.
 # gb_ExternalProject_get_build_flags project
 gb_ExternalProject_get_build_flags = $(call gb_LinkTarget__get_debugflags,ExternalProject_$(1))
diff --git a/engine/external/liborcus/ExternalProject_liborcus.mk b/engine/external/liborcus/ExternalProject_liborcus.mk
--- a/engine/external/liborcus/ExternalProject_liborcus.mk
+++ b/engine/external/liborcus/ExternalProject_liborcus.mk
@@ -33,7 +33,7 @@
 
 #$(if $(filter MSC,$(COM)),CPPFLAGS+="-DBOOST_ALL_NO_LIB") CXXFLAGS+="$(BOOST_CXXFLAGS))
 
-liborcus_LIBS=
+liborcus_LIBS=$(gb_ExternalProject_BIONIC_LIBS)
 ifneq ($(SYSTEM_ZLIB),)
 liborcus_LIBS+=-lz
 endif
