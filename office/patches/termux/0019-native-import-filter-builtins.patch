--- a/engine/external/librevenge/ExternalProject_librevenge.mk
+++ b/engine/external/librevenge/ExternalProject_librevenge.mk
@@ -35,6 +35,7 @@
 			--without-docs \
 			$(gb_CONFIGURE_DEPENDENCY_TRACKING) \
 			$(if $(verbose),--disable-silent-rules,--enable-silent-rules) \
+			$(if $(gb_ExternalProject_BIONIC_LIBS),LIBS="$(gb_ExternalProject_BIONIC_LIBS) $(LIBS)") \
 			CXXFLAGS="$(gb_CXXFLAGS) $(call gb_ExternalProject_get_build_flags,librevenge)" \
 			CPPFLAGS="$(CPPFLAGS) $(BOOST_CPPFLAGS)" \
 			$(gb_CONFIGURE_PLATFORMS) \
