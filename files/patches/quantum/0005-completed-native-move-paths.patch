+// CopyOptions carries the owning native source policy and bounded publication observer.
+type CopyOptions struct {
+	RejectSymlinks bool
+	Completed      func(string)
+}
+
+func rejectsSymlinks(options []CopyOptions) bool {
+	for _, option := range options {
+		if option.RejectSymlinks {
+			return true
+		}
+	}
+	return false
+}
+func checkCopyLink(name string, options []CopyOptions) error {
+	if !rejectsSymlinks(options) {
+		return nil
+	}
+	info, err := os.Lstat(name)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if info.Mode()&os.ModeSymlink != 0 {
+		return &os.PathError{Op: "copy", Path: name, Err: syscall.ELOOP}
+	}
+	return nil
+}
+
+// MoveSourceRemovalError identifies a copied move whose source cleanup failed.
+type MoveSourceRemovalError struct{ Err error }
+
+func (e *MoveSourceRemovalError) Error() string { return e.Err.Error() }
+func (e *MoveSourceRemovalError) Unwrap() error { return e.Err }
