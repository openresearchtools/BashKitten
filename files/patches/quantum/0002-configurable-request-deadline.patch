 // withTimeoutHelper adds a configurable timeout context to any operation.
 func withTimeoutHelper(timeout time.Duration, fn handleFunc) handleFunc {
 	return func(w http.ResponseWriter, r *http.Request, data *requestContext) (int, error) {
+		// A trusted private Unix gateway can own idle/progress deadlines for
+		// healthy byte streams, while ordinary API work retains a total budget.
+		if settings.Config.Http.ProxyTransferTimeouts && settings.Config.Http.Socket != "" && settings.Config.Http.TrustProxyHeaders &&
+			r.Method == http.MethodGet && (strings.HasSuffix(r.URL.Path, "/resources/view") || strings.HasSuffix(r.URL.Path, "/media/stream")) {
+			return fn(w, r, data)
+		}
+		if settings.Config.Http.RequestTimeoutMs > 0 {
+			timeout = time.Duration(settings.Config.Http.RequestTimeoutMs) * time.Millisecond
+		}
 		// Create a context with the specified timeout
 		ctx, cancel := context.WithTimeout(r.Context(), timeout)
 		defer cancel()
