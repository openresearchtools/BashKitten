[Desktop Entry]
Name=BashKitten
GenericName=Web Browser
Comment=A browser for the Pi coding agent
Exec=bashkitten %u
Icon=com.bashkitten
Terminal=false
Type=Application
Categories=Network;WebBrowser;Development;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=com.bashkitten
