## about:preferences

# Main
update-application-manual =
    .label = Never check for updates (not recommended)
    .accesskey = N

## Settings panes

# Badge shown on Settings groups and controls that are exclusive to BashKitten.
bashkitten-settings-exclusive-badge = BashKitten Exclusive

# Product information and the supported spelling controls.
bashkitten-about-description =
    .label = { -brand-short-name } { $version }
    .description = An open-source browser with a built-in interface for native Pi agents. Based on Firefox ESR { $engine }.
bashkitten-about-project-heading =
    .label = Project and licences
bashkitten-about-licenses =
    .label = Licences and third-party notices
    .description = Offline notices for the browser, Agent server, Pi, search, authentication and their bundled dependencies.
bashkitten-engine-licenses =
    .label = Browser engine licences
bashkitten-updates-heading =
    .label = Updates
bashkitten-updates-description =
    .label = Managed by your package manager
    .description = The Linux package updates BashKitten and its bundled components. Pi runtime updates are available in Agent settings.
bashkitten-updates-releases =
    .label = View BashKitten releases
bashkitten-about-source =
    .label = Source code
bashkitten-about-build =
    .label = Build information
bashkitten-about-support =
    .label = Support and report an issue
    .description = Open the BashKitten issue tracker on GitHub.
bashkitten-spelling-heading =
    .label = Spelling
bashkitten-spelling-enabled =
    .label = Check spelling as you type
    .description = English (United Kingdom) and English (United States) dictionaries are included. Choose the spelling language from a text field’s context menu.

bashkitten-restore-tabs =
    .label = Open previous tabs
