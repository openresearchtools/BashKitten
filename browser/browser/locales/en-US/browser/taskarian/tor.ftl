taskarian-tor-toolbar-button =
    .label = Tor
    .tooltiptext = Route this tab through Tor for .onion access. For Tor Browser’s full privacy protections, use Tor Browser.

taskarian-tor-toolbar-button-starting =
    .label = Tor
    .tooltiptext = Starting Tor…

taskarian-tor-toolbar-button-on =
    .label = Tor
    .tooltiptext = Tor is on for this tab. For Tor Browser’s full privacy protections, use Tor Browser.

taskarian-tor-privacy-notice = Tor in Taskarian is for accessing .onion sites. It does not provide all of Tor Browser’s privacy protections. For privacy-sensitive browsing on other websites, use Tor Browser.

taskarian-tor-toolbar-button-error =
    .label = Tor unavailable
    .tooltiptext = Tor could not start; activate to retry
# V3 onion service client authorization
taskarian-onion-auth-title = Onion service authorization
taskarian-onion-auth-explanation = This onion service requires a private key from its operator. Enter the key to connect.
taskarian-onion-auth-failed = This onion service rejected the key. It may be incorrect or revoked. Enter a different key from its operator.
taskarian-onion-auth-address = Onion address
taskarian-onion-auth-key = Private key
taskarian-onion-auth-name = Identity name (optional)
taskarian-onion-auth-remember = Remember this address and key, encrypted in this browser profile
taskarian-onion-auth-private-mode = Private mode for this onion site
taskarian-onion-auth-private-mode-description = Turn off for a trusted site to remember its key, login cookies and history. This tab still uses Tor.
taskarian-onion-auth-saved = Saved and session authorizations
taskarian-onion-auth-connect =
    .label = Connect
taskarian-onion-auth-save =
    .label = Save key
taskarian-onion-auth-edit = Replace key
taskarian-onion-auth-remove = Remove
taskarian-onion-auth-save-error = Could not apply or save this key. Check the onion address and the private key, and unlock your Primary Password if prompted.
taskarian-onion-auth-unlock-error = Saved authorizations could not be unlocked.
taskarian-onion-auth-saved-status = Authorization saved.
