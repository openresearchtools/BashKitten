XPIDL_SOURCES += [
    "nsIBashKittenBlocker.idl",
]

XPIDL_MODULE = "bashkitten_blocker"

UNIFIED_SOURCES += [
    "BashKittenBlockerXPCOM.cpp",
]

EXPORTS += [
    "BashKittenBlockerXPCOM.h",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

JAR_MANIFESTS += [
    "jar.mn",
]

EXTRA_JS_MODULES += [
    "BashKittenBlockedPage.sys.mjs",
    "BashKittenBlockedPageChild.sys.mjs",
    "BashKittenBlockedPageParent.sys.mjs",
    "BashKittenBlockerChild.sys.mjs",
    "BashKittenBlockerExtensionDetector.sys.mjs",
    "BashKittenBlockerPanel.sys.mjs",
    "BashKittenBlockerParent.sys.mjs",
    "BashKittenBlockerService.sys.mjs",
    "BashKittenBlockerStartup.sys.mjs",
    "BashKittenBlockerUtils.sys.mjs",
]

EXTRA_JS_MODULES.internal += [
    "internal/BundledResources.sys.mjs",
    "internal/EngineCache.sys.mjs",
    "internal/ListCatalog.sys.mjs",
    "internal/ListPreprocessor.sys.mjs",
    "internal/ListStore.sys.mjs",
    "internal/ListUpdates.sys.mjs",
    "internal/Resources.sys.mjs",
    "internal/SiteExceptions.sys.mjs",
]

BROWSER_CHROME_MANIFESTS += ["test/browser/browser.toml"]

XPCSHELL_TESTS_MANIFESTS += ["test/unit/xpcshell.toml"]

FINAL_LIBRARY = "xul"
