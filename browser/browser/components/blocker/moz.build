XPIDL_SOURCES += [
    "nsITaskarianBlocker.idl",
]

XPIDL_MODULE = "taskarian_blocker"

UNIFIED_SOURCES += [
    "TaskarianBlockerXPCOM.cpp",
]

EXPORTS += [
    "TaskarianBlockerXPCOM.h",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

JAR_MANIFESTS += [
    "jar.mn",
]

EXTRA_JS_MODULES += [
    "TaskarianBlockedPage.sys.mjs",
    "TaskarianBlockedPageChild.sys.mjs",
    "TaskarianBlockedPageParent.sys.mjs",
    "TaskarianBlockerChild.sys.mjs",
    "TaskarianBlockerExtensionDetector.sys.mjs",
    "TaskarianBlockerPanel.sys.mjs",
    "TaskarianBlockerParent.sys.mjs",
    "TaskarianBlockerService.sys.mjs",
    "TaskarianBlockerStartup.sys.mjs",
    "TaskarianBlockerUtils.sys.mjs",
]

EXTRA_JS_MODULES.internal += [
    "internal/BundledResources.sys.mjs",
    "internal/EngineCache.sys.mjs",
    "internal/ListCatalog.sys.mjs",
    "internal/ListPreprocessor.sys.mjs",
    "internal/ListStore.sys.mjs",
    "internal/ListUpdates.sys.mjs",
    "internal/Resources.sys.mjs",
    "internal/SiteExceptions.sys.mjs",
]

BROWSER_CHROME_MANIFESTS += ["test/browser/browser.toml"]

XPCSHELL_TESTS_MANIFESTS += ["test/unit/xpcshell.toml"]

FINAL_LIBRARY = "xul"
