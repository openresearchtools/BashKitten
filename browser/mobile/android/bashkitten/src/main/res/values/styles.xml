<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/bashkitten_surface</item>
        <item name="android:colorBackground">@color/bashkitten_surface</item>
        <item name="android:colorForeground">@color/bashkitten_text</item>
        <item name="android:textColorPrimary">@color/bashkitten_text</item>
        <item name="android:textColorSecondary">@color/bashkitten_secondary</item>
        <item name="android:colorAccent">@color/bashkitten_secondary</item>
        <item name="android:colorControlNormal">@color/bashkitten_secondary</item>
        <item name="android:colorControlActivated">@color/bashkitten_secondary</item>
        <item name="android:colorButtonNormal">@color/bashkitten_button</item>
        <!-- MaterialButton uses this pair, not AppCompat's colorButtonNormal. -->
        <item name="colorPrimary">@color/bashkitten_secondary</item>
        <item name="colorOnPrimary">@color/bashkitten_surface</item>
        <item name="colorSurface">@color/bashkitten_surface</item>
        <item name="colorOnSurface">@color/bashkitten_text</item>
        <item name="colorAccent">@color/bashkitten_secondary</item>
        <item name="colorControlNormal">@color/bashkitten_secondary</item>
        <item name="colorControlActivated">@color/bashkitten_secondary</item>
        <item name="colorButtonNormal">@color/bashkitten_button</item>
        <item name="android:buttonStyle">@style/BashKittenButton</item>
        <item name="buttonStyle">@style/BashKittenButton</item>
        <item name="alertDialogTheme">@style/BashKittenDialogTheme</item>
    </style>
    <style name="BashKittenButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bashkitten_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
    <style name="BashKittenDialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@drawable/bashkitten_dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/BashKittenDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/BashKittenDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/BashKittenDialogButton</item>
    </style>
    <style name="BashKittenDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/bashkitten_text</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- All BashKitten dialogs reuse the browser's effective surface/text colors. -->
    <style name="BashKittenSidecarDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:fontFamily">sans-serif</item>
        <item name="shapeAppearance">@style/BashKittenDialogShape</item>
        <item name="colorPrimary">?attr/colorOnSurface</item>
        <item name="colorAccent">?attr/colorOnSurface</item>
        <item name="android:colorAccent">?attr/colorOnSurface</item>
        <item name="colorControlActivated">?attr/colorOnSurface</item>
        <item name="buttonBarPositiveButtonStyle">@style/BashKittenSidecarDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/BashKittenSidecarDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/BashKittenSidecarDialogButton</item>
    </style>
    <style name="BashKittenSidecarDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
    <style name="BashKittenDialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
