From: BashKitten contributors
Subject: [PATCH] build released libtirpc types and report the selected Xorg version

libtirpc 1.3.8 supplies quad_t and u_quad_t in its public rpc/types.h for
non-glibc platforms. Remove the older recipe's command-line typedef macros,
which now expand inside those typedefs and fail on Android, and remove the
duplicate typedefs in the donor's generated Xorg configuration. Retain the remaining
Android build selection and private embedded module. Report the selected
Xorg server 21.1.25 instead of the donor recipe's development version.
Modified 19 October 2026; retains the Termux:X11 recipe's GPL-3.0-only terms.

--- a/lorie/src/main/cpp/recipes/tirpc.cmake
+++ b/lorie/src/main/cpp/recipes/tirpc.cmake
@@ -45,6 +45,6 @@
 target_include_directories(tirpc PUBLIC "libtirpc/tirpc")
 target_compile_options(tirpc PRIVATE "-DPORTMAP" "-DINET6=1" "-DHAVE_FEATURES_H=1"
         "-DHAVE_GETRPCBYNAME=1" "-DHAVE_GETRPCBYNUMBER=1" "-DHAVE_SETRPCENT=1" "-DHAVE_ENDRPCENT=1"
-        "-DHAVE_GETRPCENT=1" "-UHAVE_GSSAPI_GSSAPI_EXT_H" "-UAUTHDES_SUPPORT" "-Dquad_t=long long"
-        "-Du_quad_t=unsigned long long" "-Dgetdtablesize()=sysconf(_SC_OPEN_MAX)" "-D_GNU_SOURCE"
+        "-DHAVE_GETRPCENT=1" "-UHAVE_GSSAPI_GSSAPI_EXT_H" "-UAUTHDES_SUPPORT"
+        "-Dgetdtablesize()=sysconf(_SC_OPEN_MAX)" "-D_GNU_SOURCE"
         "-Wall" "-pipe" "-fPIC" "-DPIC" "-Wno-deprecated-non-prototype" "-Wno-macro-redefined")
--- a/lorie/src/main/cpp/recipes/xserver.cmake
+++ b/lorie/src/main/cpp/recipes/xserver.cmake
@@ -6,7 +6,7 @@
         CONTENT "
 #pragma once
 #define VENDOR_NAME \"The X.Org Foundation\"
-#define VENDOR_RELEASE 12101099
+#define VENDOR_RELEASE 12101025
 ")
 
 file(GENERATE
--- a/lorie/src/main/cpp/patches/dix-config.h.in
+++ b/lorie/src/main/cpp/patches/dix-config.h.in
@@ -171,8 +171,6 @@
 #undef XSERVER_PLATFORM_BUS
 
 #ifdef ANDROID
-typedef long long quad_t;
-typedef unsigned long long u_quad_t;
 
 #include <unistd.h>
 
