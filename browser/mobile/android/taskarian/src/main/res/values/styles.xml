<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/taskarian_surface</item>
        <item name="android:colorBackground">@color/taskarian_surface</item>
        <item name="android:colorForeground">@color/taskarian_text</item>
        <item name="android:textColorPrimary">@color/taskarian_text</item>
        <item name="android:textColorSecondary">@color/taskarian_secondary</item>
        <item name="android:colorAccent">@color/taskarian_secondary</item>
        <item name="android:colorControlNormal">@color/taskarian_secondary</item>
        <item name="android:colorControlActivated">@color/taskarian_secondary</item>
        <item name="android:colorButtonNormal">@color/taskarian_button</item>
        <!-- MaterialButton uses this pair, not AppCompat's colorButtonNormal. -->
        <item name="colorPrimary">@color/taskarian_secondary</item>
        <item name="colorOnPrimary">@color/taskarian_surface</item>
        <item name="colorSurface">@color/taskarian_surface</item>
        <item name="colorOnSurface">@color/taskarian_text</item>
        <item name="colorAccent">@color/taskarian_secondary</item>
        <item name="colorControlNormal">@color/taskarian_secondary</item>
        <item name="colorControlActivated">@color/taskarian_secondary</item>
        <item name="colorButtonNormal">@color/taskarian_button</item>
        <item name="android:buttonStyle">@style/TaskarianButton</item>
        <item name="buttonStyle">@style/TaskarianButton</item>
        <item name="alertDialogTheme">@style/TaskarianDialogTheme</item>
    </style>
    <style name="TaskarianButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/taskarian_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
    <style name="TaskarianDialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@drawable/taskarian_dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/TaskarianDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/TaskarianDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/TaskarianDialogButton</item>
    </style>
    <style name="TaskarianDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/taskarian_text</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- All Taskarian dialogs reuse the browser's effective surface/text colors. -->
    <style name="TaskarianSidecarDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:fontFamily">sans-serif</item>
        <item name="shapeAppearance">@style/TaskarianDialogShape</item>
        <item name="colorPrimary">?attr/colorOnSurface</item>
        <item name="colorAccent">?attr/colorOnSurface</item>
        <item name="android:colorAccent">?attr/colorOnSurface</item>
        <item name="colorControlActivated">?attr/colorOnSurface</item>
        <item name="buttonBarPositiveButtonStyle">@style/TaskarianSidecarDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/TaskarianSidecarDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/TaskarianSidecarDialogButton</item>
    </style>
    <style name="TaskarianSidecarDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
    <style name="TaskarianDialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
