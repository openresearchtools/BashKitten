<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/wildbuzzard_surface</item>
        <item name="android:colorBackground">@color/wildbuzzard_surface</item>
        <item name="android:colorForeground">@color/wildbuzzard_text</item>
        <item name="android:textColorPrimary">@color/wildbuzzard_text</item>
        <item name="android:textColorSecondary">@color/wildbuzzard_secondary</item>
        <item name="android:colorAccent">@color/wildbuzzard_secondary</item>
        <item name="android:colorControlNormal">@color/wildbuzzard_secondary</item>
        <item name="android:colorControlActivated">@color/wildbuzzard_secondary</item>
        <item name="android:colorButtonNormal">@color/wildbuzzard_button</item>
        <item name="colorAccent">@color/wildbuzzard_secondary</item>
        <item name="colorControlNormal">@color/wildbuzzard_secondary</item>
        <item name="colorControlActivated">@color/wildbuzzard_secondary</item>
        <item name="colorButtonNormal">@color/wildbuzzard_button</item>
        <item name="alertDialogTheme">@style/WildBuzzardDialogTheme</item>
    </style>
    <style name="WildBuzzardDialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="buttonBarPositiveButtonStyle">@style/WildBuzzardDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/WildBuzzardDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/WildBuzzardDialogButton</item>
    </style>
    <style name="WildBuzzardDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/wildbuzzard_text</item>
    </style>
</resources>
